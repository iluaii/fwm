# fwm configuration file
# ~/.config/fwm/config.toml

# Realistic preset: earth gravity (9.8 m/s^2 at 100 px/m scale), dull heavy
# bounce, long weighty glides in zero-g.
# Old "cartoon" feel: friction 0.97, restitution 0.75, gravity 200.
[physics]
friction              = 0.985
mass_density          = 0.0005
throw_speed_multiplier = 0.65
max_throw_speed       = 1800.0
stop_speed_threshold  = 1.0
restitution           = 0.3
gravity               = 981.0
tick_rate             = 60.0
# What decides how heavy a window is:
#   "size"  window mass = area * mass_density (the default)
#   "ram"   how much memory the application is using, its size ignored — the
#           browser that has eaten two gigabytes becomes the heaviest thing on
#           the desktop and shoves everything else out of the way. Counted over
#           the whole process tree, so a browser's tabs count toward its window,
#           and re-read every second and a half.
# Also switchable in the modes menu (the tray pill), which remembers the choice
# in ~/.local/state/fwm/modes and thereafter overrides what is written here.
#mass                 = "ram"
#mass_ram_ref         = 300.0   # MB that weighs a normal window
#mass_ram_max         = 20.0    # heaviest a window may get, x normal. Uncap it
                                # and a 6GB browser is not heavy, it is a wall.
# What super+g cycles through: multipliers on the gravity above, in order.
# The default is the built-in trio — weightless, a lick of it, earth.
#gravity_steps        = [0.0, 0.15, 1.0]

# Make an external bar a solid object. A layer-shell panel that reserved space
# for itself (waybar, quickshell, a dock) then holds the floor up: a thrown
# window lands ON the bar instead of sliding away underneath it, and a bar
# along the top of the screen is a ceiling. Off by default, and the windows go
# under the bar exactly as they always have.
#
# fwm's own tray is not affected — it floats above the windows and always has.
#solid_bars           = true

# Breakable windows. A single hard enough collision destroys a window; damage
# is never accumulated, so anything that survives a hit is unharmed by it.
#
#   damage(A -> B) = mass(A) * (speed / hp_break_speed)^2 * hardness(A)
#   hp(B)          = mass(B) * toughness(B)
#
# Both sides are worked out the same way, so two equal windows meeting fast
# enough destroy each other. Walls never deal damage — otherwise every window
# dropped from the top of the screen would shatter on the floor.
#
# hp_break_speed reads as "how fast a window must hit another OF ITS OWN MASS
# to destroy it". Left at 0 it follows max_throw_speed, and because nothing may
# travel faster than that limit, a window is then incapable of breaking
# anything heavier than itself. Lower it and a fast light window punches above
# its weight.
#
# There is deliberately NO key to switch this on. It is the one mode that can
# lose unsaved work, so it lives in the modes menu ("Breakable"), applies to the
# session you turned it on in, and is never written to disk or restored: every
# session starts with windows unbreakable. Windows are ASKED to close, so a
# client with something to save can still put up its own dialog.
#
# The speed below only says HOW breaking works if you ever turn it on.
#hp_break_speed       = 0.0     # 0 = follow max_throw_speed

# Physics per desktop. A [physics.<name>] table is a DIFF against the block
# above: it writes friction / mass_density / restitution / gravity, inherits
# everything it does not mention, and names the desktops it applies to. A
# desktop no profile claims behaves exactly as [physics] says, so adding this
# section changes nothing until you point one at a desktop.
#
# Windows carry their desktop's physics: drag one from the moon onto the water
# desktop and it slows down as it crosses the edge. super+g still turns gravity
# off everywhere at once — it is the master switch, and 0 there is 0 here too.
#
#[physics.moon]
#gravity  = 160.0          # a sixth of earth: long, slow falls
#desktops = [3, 4]
#
#[physics.water]
#friction    = 0.9         # everything comes to a stop quickly
#restitution = 0.05        # and lands without a bounce
#gravity     = 300.0
#desktops    = [7]

# Windows knock when they hit each other, the floor or the walls. Off by
# default — a compositor should not make noises because it was installed.
# Also a switch in the modes menu (the tray pill), which remembers it.
#
# `path` is a WAV file (16-bit PCM or 32-bit float, mono or stereo); leave it
# out for the built-in click. Volume follows how hard the hit was, between
# min_speed (silent) and max_speed (full), and heavier windows knock deeper.
#[sound]
#collisions = true
#path       = "~/sounds/knock.wav"
#volume     = 0.6
#min_speed  = 200.0    # px/s: a nudge below this is not worth hearing
#max_speed  = 2000.0   # px/s: full volume at and above this

# What the machine is doing, in the tray: the island between the desktop dots
# and the modes pill. Click it for the menu that switches each readout on and
# off, or bind the `stats_menu` action to a key.
#
# Three sensors are built in:
#
#   cpu   how much of the last second every core spent working
#   ram   memory in use (total minus MemAvailable, i.e. what you actually mean)
#   gpu   how busy the card is; needs a driver that reports it (amdgpu, i915).
#         A card that does not is shown greyed in the menu rather than hidden.
#
# ANY OTHER KEY HERE IS A SENSOR OF YOUR OWN: the key is its name, the value is
# a shell command, and what the command prints on its first line is what the
# tray shows. One line per sensor, which is the whole point — a readout you
# have to write four lines of ceremony for is a readout nobody adds.
#
# `items` is both the selection and the order; a name in it that is neither
# built in nor defined below is reported as a config problem rather than
# quietly left out. `interval` (seconds, floor 0.5) is how often the commands
# are run — the built-ins sample once a second regardless. A command is run in
# its own process group and killed if it has not answered in five seconds, and
# only one run of it exists at a time, so a slow sensor reports less often
# instead of piling up processes.
#[stats]
#items    = ["cpu", "ram", "gpu", "vol", "mic"]
#interval = 2.0
#vol = "pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1"
#mic = "pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes && echo off || echo on"

# Window decorations: focus border colors ("#RRGGBB" or "#RRGGBBAA"),
# border width (0 disables) and map fade-in duration (0 disables).
[decor]
border_width = 2
col_active   = "#7aa2f7"
col_inactive = "#3b4261"
# Window appear/close animation, ms. Short values read as a pop rather than a
# fade — 260 is a calm default; 0 disables.
fade_in_ms   = 260.0
# Cross-fade when the wallpaper is swapped at runtime (picker); 0 = instant cut.
wallpaper_fade_ms = 420.0
# Island fill opacity (0..1), separate for the tray bar and the app launcher.
tray_opacity     = 0.92
# Let an external bar REPLACE the status strip instead of stacking with it. On a
# monitor where a layer-shell panel (waybar, quickshell, a dock) reserved space
# along the top, fwm's strip hides itself and stops reserving its own band.
#
# Off by default: a client asking for space must not be able to take fwm's own
# chrome off the screen by itself. Running a bar instead of the strip is your
# decision, and this is where you make it. Per monitor — a second screen with no
# bar keeps its strip. Only an exclusive zone counts; a panel that floats over
# the top without reserving space changes nothing.
#tray_yield       = true
launcher_opacity = 0.92
# Launcher icon theme. "" = auto: gtk-3.0 settings.ini, then hicolor.
icon_theme = ""
# Where the UI palette comes from.
#   "config"    — the colours above plus the built-in dark scheme (default)
#   "wallpaper" — derive it from the first [[wallpaper]] image: the tray,
#                 panels, launcher and tab bars are tinted toward its dominant
#                 hue, and the focus border / desktop marker / tab underline
#                 take its most vivid colour. Islands are always kept dark, so
#                 text stays readable no matter the image. A greyscale
#                 wallpaper falls back to the colours above.
color_source     = "config"
# 0..1: how far the islands move toward the wallpaper hue. 0 = untinted
# (accent only), 1 = as far as the palette allows.
tint_strength    = 0.4

# Hyprland-style tiling: gaps and the tile-glide animation.
# anim_speed is 1/s (12 ~ 250ms glide); 0 disables the animation.
[tiling]
gaps_in    = 6
gaps_out   = 14
anim_speed = 12.0

# Desktop-switch camera slide (ease-in-out). 0 = instant snap.
# free_speed is a different motion: how tightly the camera follows a HELD
# move_camera: bind (1/s, higher = tighter, lower = more coasting).
# wrap makes the ten desktops a ring: going right off the last one arrives on
# the first, and a window sent that way goes with it. It applies to view:next
# and view:prev, to a held move_camera:, to the wheel over the tray's desktop
# island, and to dragging a window into the edge of the screen. Plain view:N is
# a destination, not a step, so it never wraps.
#
# The join is jumped rather than slid through: there is no picture of it to
# slide through, since the desktops are one straight strip underneath.
# Toggle at runtime with the `toggle_wrap` action, or `x` inside expo.
[camera]
anim_ms    = 350.0
free_speed = 14.0
wrap       = false

# ── monitors ────────────────────────────────────────────────────────────
# Each monitor shows one of the ten desktops and switches on its own; a
# desktop bind moves whichever screen the pointer is on. Without an [[output]]
# entry a monitor is placed to the right of the ones already there and takes
# the lowest desktop nobody else has, so this section is only needed to say
# otherwise.
#
# `name` is what fwm logs at startup ("output HDMI-A-1: 1920x1080") — the same
# name wlr-randr and swaymsg use. x/y are the top-left corner in layout
# coordinates and must be given together; the monitor at 0,0 is the primary
# one, which is where the welcome and error panels open and whose size every
# desktop takes. `desktop` is what that screen comes up on, and `enabled =
# false` leaves it dark. Reloading the config re-applies all of it — except
# that it never re-lights a monitor turned off at runtime, so a reload with the
# laptop shut does not wake the panel inside the lid.
#
# `mode`, `scale` and `transform` say how the monitor is driven. A monitor with
# no `mode` comes up in its preferred one, which is nearly always right; set it
# when it is not. The whole entry is applied in one tested commit, so a mode the
# hardware refuses leaves the screen running what it was running (and says so in
# the log) rather than going black.
#
#   mode      = "2560x1440"     # highest refresh the monitor offers at that size
#   mode      = "2560x1440@144" # ...or exactly this one; `fwmctl outputs` lists them
#   scale     = 1.5             # HiDPI factor
#   transform = "90"            # normal, 90, 180, 270, flipped, flipped-90, ...
#
# At runtime: `fwmctl outputs` shows every screen and every mode it offers, and
# `fwmctl output <name> mode=... scale=... transform=... position=X,Y
# desktop=N enabled=on|off` changes one — the same settings as here, applied
# through the same code, and undone by the next reload. `output_off` puts out
# the screen the pointer is on, `toggle_internal_output` the built-in panel, and
# `outputs_on` brings them all back. Closing the lid turns the panel off by
# itself whenever another monitor is connected; with nothing else plugged in it
# is left alone, since a session with no screen at all is a suspend for logind
# to decide on, not this.
#
#   [[output]]
#   name    = "eDP-1"        # the laptop panel, on the left, primary
#   x       = 0
#   y       = 0
#   desktop = 0
#
#   [[output]]
#   name    = "HDMI-A-1"     # the external screen to the right of it
#   mode    = "1920x1080@60"
#   x       = 1366
#   y       = 0
#   desktop = 1

# What an app is allowed to do when it asks to be raised (xdg-activation):
# a link opening in an already-running browser, a chat client jumping to a
# message. The annoying part is not the focus change but the camera leaving
# the desktop you are working on, so these are separate:
#   "never"        — ignore such requests entirely
#   "same_desktop" — (default) focus it only if it is already on screen
#   "always"       — focus it and pan the camera to wherever it lives
[focus]
on_activate = "same_desktop"

# Impact effects, both scaled by collision speed so gentle bumps stay subtle.
#
# camera_shake jolts the wallpaper and windows when something lands hard (the
# tray and panels never move — jittering UI reads as a glitch, not as impact).
# OFF by default: moving the whole view on every landing is intrusive while
# you are actually working. Set 1.0 for the default strength, up to 4.
#
# squash deforms a window on impact — compressed along the contact, bulging
# across it, springing back through a smaller overshoot. 0 disables.
#
# jelly makes a dragged window go soft, the way KDE's wobbly windows do: it is
# a sheet of springs, so the part you grabbed keeps up with the cursor while
# the rest of it bends and arrives late, and shaking the window wobbles it for
# a beat after you stop. Scales how far it bends, not how fast; 0 disables, up
# to 2. Needs the GLES2 renderer (the bend is a mesh), and never applies to a
# spinning window — rotation owns the picture. While a window wobbles its
# border is hidden, since a rectangle cannot bend with it.
[effects]
camera_shake = 0.0
squash       = 1.0
jelly        = 1.0
# Strength of the kick spin_window gives a window, 0..4. 0 disables the bind.
# (Stirring the mouse while dragging a spinning window is not scaled by this —
# there the window simply turns at the rate your hand does.)
spin         = 1.0
# The region screenshot peeling off the screen: a frozen copy of what was just
# photographed lifts off, shrinks, tilts and flies down into the message that
# says it was copied, while the live screen carries on underneath. (The tilt
# needs the GLES2 renderer; elsewhere it flies upright.) Scales duration and
# distance together: 0.5 is a flick, 2.0 a slow drift, 0 turns it off. Only
# screenshot_region has it — Print stays instant.
shot_fly     = 1.0
# Live content while a window spins or wobbles: the client keeps drawing while
# the effect hides it, instead of the effect showing a still frame. A window
# that is a single surface is drawn straight from the client's texture for
# free; anything else is flattened into a picture whenever the client draws, at
# most 30 times a second (~0.3ms each here).
#
# Set to 0 for the old still frame, refreshed a few times a second, with the
# client left asleep — cheaper, and the thing to try if an effect judders.
# Switchable live, without a reload: `fwmctl set effects.live 0`.
# FWM_DEBUG_EFFECTS=1 in the environment logs what the effects actually cost.
live         = 1.0

# Audio spectrum bars along the bottom of the screen, fed by loopback capture
# of whatever is playing — no external cava process, and nothing to launch.
#
# The two halves are independent, which is the whole reason this is one key with
# four values instead of two booleans nobody would think to combine:
#
#   "off"       (default) nothing runs and no audio stream is opened at all
#   "visual"    draw the bars, never touch the windows
#   "physical"  the bars are INVISIBLE but real — a row of solid, moving bodies
#               along the floor that windows stand on and get tossed by
#   "both"      draw them and let them throw your windows around
#
# The physical half only works on a desktop in physics mode (a tiled or floating
# desktop owns its geometry, so nothing there can be pushed), and the row stands
# on the floor of the desktop you are looking at.
#
# Captures through PipeWire or PulseAudio, whichever is already running — fwm
# never starts a sound server of its own. With neither running, no bars.
[cava]
mode        = "off"
# How many bands. Each one is a real body in the world while physical, so this
# is a cost and not just a number: 48 across 1080p is a ~22px bar.
bars        = 48
# Px the loudest band reaches, and the px gap between bars.
height      = 160
gap         = 3
# Spectrum gain. Raise it if the bars barely move at your usual volume.
sensitivity = 1.0
# How the bars fall, 0..0.99. 0 drops them the instant the sound stops; 0.9
# leaves them hanging. They always RISE instantly — rounding off the attack
# throws away the only part of a beat worth looking at.
smoothing   = 0.75
# Physical bar height as a fraction of the drawn one, 0..4. 0 turns the pushing
# off while leaving the bars drawn; 2 makes windows dance twice as hard. This
# scales how fast a bar may rise as well, so it is the one "how wild is it" knob.
push        = 1.0
# Alpha of the drawn bars. They take their colour from the theme, like the tray.
opacity     = 0.85
# Band edges, Hz. The row is spaced by octaves between them, not linearly.
min_hz      = 40
max_hz      = 12000

# When a restarted fwm should put your applications back. fwm records what is
# running and on which desktop, and relaunches it — the applications restart,
# they do not resume, so anything unsaved inside them is still lost.
#
#   "crash"  — (default) only when the last run ended badly. fwm deletes the
#              record on a clean shutdown, so a normal logout gives you a clean
#              desktop and only a crash brings the windows back.
#   "always" — every start, including a normal login.
#   "never"  — nothing is recorded and nothing is relaunched.
[session]
restore = "crash"

[input]
# xkb keyboard: several layouts + a grp:* option = layout switching.
# The FIRST layout must stay Latin so binds keep working on any layout.
kbd_layout  = "us,ru"
kbd_options = "grp:alt_shift_toggle"
# kbd_variant = ""
repeat_rate  = 25
repeat_delay = 600

# Touchpad. Everything here is libinput's, and everything except `tap` is left
# at whatever libinput chose for your model unless you say otherwise — those
# defaults are per-device and usually better than a number in a config file.
#
# tap is the exception: fwm turns tap-to-click ON, because libinput ships it off
# and a laptop where touching the pad does not click is unusable without a
# mouse. Set tap = false to get libinput's own default back.
#
# A pad that cannot do one of these ignores it (a mouse has no tap and no
# disable-while-typing). `libinput list-devices` shows what yours supports:
# "disabled" means it can and is off, "n/a" means it cannot at all.
tap = true
#tap_drag         = true    # tap, then slide = drag
#drag_lock        = false   # a drag survives lifting the finger briefly
#natural_scroll   = false   # content follows the fingers
#dwt              = true    # ignore the pad while typing
#middle_emulation = false   # left+right together = middle click
#left_handed      = false
#accel_speed      = 0.0     # -1 (slow) .. 1 (fast)
#accel_profile    = "adaptive"    # or "flat" (no acceleration)
#scroll_method    = "two_finger"  # or "edge", "button", "none"
#click_method     = "button_areas" # or "clickfinger", "none"

[binds]
# format: "mod+key" = "action"
# mod keys: super, alt, shift, ctrl
# system actions: terminal, killclient, toggle_tiling, fake_fullscreen, real_fullscreen,
#                 pin_window, toggle_nocollide, toggle_nocollide_all,
#                 toggle_tiling_all, toggle_floating, toggle_floating_all,
#                 calm_all, cycle_gravity, toggle_tray,
#                 spin_window, spin_all,
#                 show_hints, show_errors, modes_menu, reload_config,
#                 wallpaper_picker, launcher, expo, toggle_wrap, EXIT
# screenshots:    screenshot, screenshot_region
# monitors:       output_off, toggle_internal_output, outputs_on
# tiling:         toggle_split, tile_focus:l|r|u|d, tile_move:l|r|u|d
# tab-stacks:     group_toggle, group_next, group_prev, group_add
#
# A broken config never costs you the session: fwm falls back to built-in
# keybindings, reports the problem in a tray pill (click it for details) and
# keeps running. Fix the file and press super+shift+r to reload.
# spawn actions:  spawn:command arg1 arg2 ...
# camera:         move_camera:-50  move_camera:50
# workspace:      view:0 .. view:9              (also view:next / view:prev)
# move a window:  move_to:0 .. move_to:9        (send it there, stay put)
#                 move_to_view:0 .. :9         (send it there and follow)
#                 both take next/prev too, relative to the desktop on screen
# In physics and floating modes you can also just drag a window across the
# desktop edge; in tiling you cannot, because the layout owns its geometry —
# these actions are the way to move a tiled window out.

# `terminal` runs $TERMINAL if you have set it (arguments and all — the whole
# value goes through a shell), and otherwise the first emulator it finds
# installed, cheapest to start first. Not $TERM: that is the terminfo entry, so
# honouring it would try to run "xterm-256color" from inside kitty. Want a
# specific one regardless? spawn: takes anything, including variables of your
# own: "spawn:$MY_TERM -e tmux".
"super+Return"       = "terminal"
#"super+space"        = "spawn:rofi -show drun -normal-window"
"super+q"            = "killclient"
"super+t"            = "toggle_tiling"
# The third mode: a plain desktop environment. Windows keep the position you
# drop them at and overlap freely — no gravity, no shoving, no layout. Handy
# for the stretch of an afternoon where you just want the windows to sit still.
# Per-window pin/nocollide are left untouched, so leaving the mode gives back
# whatever you had toggled by hand. "toggle_floating_all" does every desktop.
"super+alt+space"    = "toggle_floating"
"super+space"            = "launcher"
"super+d"            = "fake_fullscreen"
"super+f"            = "real_fullscreen"
"super+h"            = "move_camera:-50"
"super+l"            = "move_camera:50"
"super+p"            = "pin_window"
"super+n"            = "toggle_nocollide"
# Global versions: every window / every desktop at once, for when an app
# launcher opens a pile of windows and toggling them one by one is hopeless.
"super+shift+n"      = "toggle_nocollide_all"
"super+shift+t"      = "toggle_tiling_all"
"super+shift+c"      = "calm_all"
"super+g"            = "cycle_gravity"
# Hide the tray outright — the bar disappears AND stops reserving its
# strip, so tiled and fake-fullscreen windows grow into the top of the
# screen. Press again to bring it back.
"super+j"            = "toggle_tray"
# EXPERIMENTAL: set the focused window spinning — the picture turns and so does
# its collision box, so it tumbles off walls and shoves neighbours with its
# corners. The press itself is a gentle nudge: the spinning comes from what you
# do with the window afterwards. While dragged it hangs from the point you took
# hold of, like a real object held there — grab it by a corner and it swings
# behind your hand (and hangs straight down if gravity is on); grab it dead
# center and it does not swing at all. Stirring the mouse in circles winds it up
# further, and it keeps whatever spin it had when you let go. Press again to settle it upright. While it spins the window
# shows a snapshot refreshed a few times a second rather than live content, and
# it is only as free to turn as the room around it: a window whose diagonal is
# taller than the screen wedges against the floor and ceiling instead of
# coming round.
"super+r"            = "spin_window"
# The same for every window at once. Unbound by default because the obvious key
# for it (super+shift+r) is reload_config; pick one that suits you.
#"super+shift+r"      = "spin_all"
"super+shift+Escape" = "EXIT"
# Bound to the physical "/" key, not to the "?" symbol: a symbol bind lands on
# a different key per layout (US shift+/, RU shift+7), while "slash" resolves
# through the layout-0 fallback and stays put on every layout.
# The desktop strip: pull the camera back until several desktops are on screen
# at once. Inside it: left/right arrows and the wheel pan, a click goes to the
# window (or the empty desktop) you clicked, super+drag moves a window —
# including onto another desktop, and to the edge of the screen to keep going —
# right-click opens a menu for the window under the cursor, x closes the strip
# into a ring, and Escape or the same bind leaves on what you are looking at.
#
# z steps back further, and at that step the ring can be flown around: drag
# with the middle button — or alt+left, for a touchpad — to turn it and to lift
# the camera over it; the wheel then moves in and out, up/down arrows tilt a
# step at a time. The camera looks at the middle of the ring, not at one
# desktop, and comes back level by itself the moment you ask for a desktop.
"super+a"            = "expo"
"super+shift+slash"  = "show_hints"
"super+shift+r"      = "reload_config"
"super+shift+p"      = "wallpaper_picker"
# Screenshots. Both put a PNG straight on the clipboard — nothing is written to
# disk, so paste it where you want it — and the region one dims the screen and
# waits for a drag (Escape cancels).
"Print"              = "screenshot"
"super+shift+s"      = "screenshot_region"
# Monitors. `super+o` puts out the screen the pointer is on; `super+shift+o`
# brings every one of them back, and is deliberately bindable to something you
# can hit blind — it is what you reach for after turning off the screen you
# were looking at. The laptop panel also goes out by itself when the lid comes
# down, provided another monitor is connected.
"super+o"            = "output_off"
"super+shift+o"      = "outputs_on"
#"super+ctrl+o"       = "toggle_internal_output"
# Lock the screen. fwm implements ext-session-lock-v1; the lock screen itself
# is drawn by an external client (hyprlock, swaylock), so this is a plain spawn.
"super+shift+l"      = "spawn:hyprlock"
# Tiling control (Hyprland-style; only active on tiling desktops)
"super+Left"         = "tile_focus:l"
"super+Right"        = "tile_focus:r"
"super+Up"           = "tile_focus:u"
"super+Down"         = "tile_focus:d"
"super+shift+Left"   = "tile_move:l"
"super+shift+Right"  = "tile_move:r"
"super+shift+Up"     = "tile_move:u"
"super+shift+Down"   = "tile_move:d"
"super+s"            = "toggle_split"
# Tab-stacks (Hyprland-style groups)
"super+w"            = "group_toggle"
"super+Tab"          = "group_next"
"super+shift+Tab"    = "group_prev"
"super+shift+w"      = "group_add"
# Send the focused window to a desktop (i3/sway convention). The camera stays
# where it is; use move_to_view: to travel with the window instead.
"super+shift+1"      = "move_to:0"
"super+shift+2"      = "move_to:1"
"super+shift+3"      = "move_to:2"
"super+shift+4"      = "move_to:3"
"super+shift+5"      = "move_to:4"
"super+shift+6"      = "move_to:5"
"super+shift+7"      = "move_to:6"
"super+shift+8"      = "move_to:7"
"super+shift+9"      = "move_to:8"
"super+shift+0"      = "move_to:9"
"super+1"            = "view:0"
"super+2"            = "view:1"
"super+3"            = "view:2"
"super+4"            = "view:3"
"super+5"            = "view:4"
"super+6"            = "view:5"
"super+7"            = "view:6"
"super+8"            = "view:7"
"super+9"            = "view:8"
"super+0"            = "view:9"
# One desktop over, without naming it. These are steps, not destinations: with
# wrap = true they carry on off desktop 9 onto 0 and back the other way, the
# same join super+h and super+l pan through.
"super+ctrl+Left"    = "view:prev"
"super+ctrl+Right"   = "view:next"

# Modes (submaps): a second keymap you step into, so bare keys can mean
# something. Press the `enter` key and the mode owns the keyboard — its binds
# fire, Escape leaves, and every other key does nothing rather than reaching the
# application underneath. The tray shows a pill with the mode's name while it is
# open; without that a mode would just look like a keyboard that stopped working.
#
# A mode is one-shot by default: the first action fires and drops you back, which
# is what a leader key is usually for. sticky = true keeps it open until Escape,
# for the modes you hold — nudging a tile's size a dozen times, say.
#
# `enter` is shorthand for putting "mode:<name>" in [binds]; you can bind that
# by hand instead, and "mode:default" from anywhere returns to the root map.
#
#[mode.physics]
#enter = "super+o"
#"g"   = "cycle_gravity"
#"c"   = "calm_all"
#"r"   = "spin_all"
#"n"   = "toggle_nocollide_all"
#
#[mode.resize]
#enter  = "super+shift+e"
#sticky = true              # stays open: resizing is never one keypress
#"Left"  = "tile_move:l"
#"Right" = "tile_move:r"

# Mouse. What a drag with a modifier held does — the same table for the pointer
# that [binds] is for the keyboard. Buttons: left, right, middle, side, extra.
# Modifiers match EXACTLY, as in [binds]: "super+left" does not fire while shift
# is also down, which is why the shift variant is its own line.
#
# Drag verbs:
#   move            drag the window; let go and it is thrown at the speed
#                   your hand had. On a tiling desktop the window LEAVES the
#                   layout as soon as the hand moves — the slot closes behind
#                   it — and is put back wherever it is dropped: beside the
#                   window it is let go over, on whichever side of that window
#                   the cursor is nearest, or onto another desktop entirely by
#                   carrying it into the edge of the screen. Dropped on a
#                   physics desktop it simply stays a free window.
#   move_nocollide  the same, but shoving nothing on the way. On a tiling
#                   desktop this drags one tile onto another to swap them.
#   swap            swap two tiles, and only that.
#   resize          drag the bottom-right corner. On a tiling desktop it
#                   resizes the tile from the corner nearest the hand, from
#                   anywhere inside the window: no aiming at the seam between
#                   two of them, and both dividers move at once when the window
#                   has one on each axis.
#   twist           turn the window with the hand: it follows the angle from
#                   its own centre to the cursor, winds up as you stir, and
#                   keeps spinning at whatever rate you let go at. Needs
#                   effects.spin > 0, and does nothing to a tiled, pinned or
#                   fullscreen window — there is nowhere for it to turn.
#
# Any [binds] action works here too and fires once on the press, so
# "super+middle" = "killclient" is a legal line.
#
# Deleting this section restores the three defaults shown below. Note that a
# bind with NO modifier will eat that button from every application.
#[mouse]
#"super+left"       = "move"
#"super+shift+left" = "move_nocollide"
#"super+right"      = "resize"
#"super+ctrl+left"  = "twist"

# Touchpad gestures. OFF by default — nothing is bound until you bind it, and a
# gesture fwm has not claimed goes to the application under the cursor, which is
# where a swipe or a pinch belongs until you say otherwise. Uncomment the block
# below to get the set worth starting from.
#
# Same actions as [binds], keyed on how many fingers went which way:
# "swipe<2..5>+left|right|up|down" and "pinch<2..5>+in|out".
#
# Two extras only a gesture can use:
#   pan_desktop        hands the camera to your fingers and pans across the
#                      desktop strip live, settling on a desktop when they
#                      lift — a flick carries on to the next one. Bind it to
#                      BOTH horizontal directions; it is one gesture.
#   view:next|prev     and move_to:next|prev, move_to_view:next|prev — the
#                      desktop beside the one you are looking at. These work in
#                      [binds] too.
#
# sensitivity: camera px per finger px (default 1.0).
# natural:     true (default) = the strip follows your fingers, as on a phone.
#
# A finger count with NOTHING bound to it is left entirely alone, so the app
# under the cursor still gets it. Leave the two-finger pinch unbound for that
# reason — it belongs to your browser and image viewer.
#
# Not every touchpad can do this. libinput only reports swipes and pinches on
# devices that track each finger separately: check for "gesture" in the
# Capabilities line of `libinput list-devices`. Older semi-MT pads (many
# SynPS/2) have only "pointer", and no gesture will ever arrive from them —
# two-finger scrolling still works, since that needs no per-finger positions.
#[gestures]
#sensitivity    = 1.0
#natural        = true
#"swipe3+left"  = "pan_desktop"
#"swipe3+right" = "pan_desktop"
#"swipe3+up"    = "launcher"
#"swipe3+down"  = "toggle_tray"
#"swipe4+left"  = "move_to_view:prev"
#"swipe4+right" = "move_to_view:next"
#"pinch3+in"    = "calm_all"

# Built-in wallpaper picker: which folder to browse (flat, no recursion).
# The pick is remembered in ~/.local/state/fwm/wallpaper and overrides the
# first [[wallpaper]] layer on the next start; this file is never rewritten.
# Deleting that state file goes back to the wallpaper configured here.
# The picker lists videos too (their icon is a random frame); picking one makes
# it a looping video wallpaper.
#
# fps: base cap applied to any VIDEO chosen through the picker — one knob for
# everything you pick, so you don't need a [[wallpaper]] block to cap it. 0 (or
# unset) = the clip's own rate. An explicit fps on a [[wallpaper]] layer is only
# overridden while this is > 0. Set it to ~half the clip's rate (e.g. 15) to
# also drop B-frames and cut the decode itself — the biggest saving on weak
# hardware (see the [[wallpaper]] fps note below).
[wallpaper_picker]
dir = "~/Pictures"
#fps = 15

# Window rules: per-window overrides applied once, when the window opens.
# Match on app_id and/or title with POSIX extended regexes — the same anchored
# style as Hyprland's `class:^(mpv)$`. A rule with both matchers needs both to
# hit; rules are applied in file order, so a later one wins field by field.
#
# Properties: nocollide, pin (booleans) and desktop (0..9), plus what the
# window is MADE of:
#
#   mass      how heavy, relative to a normal window of the same size. 8 is a
#             window nothing can shove; 0.1 skitters away when brushed.
#   gravity   multiplies the desktop's gravity. 0 = weightless in a room where
#             everything else falls, -0.2 = a balloon that drifts up.
#   bounce    restitution 0..1. 0 lands dead, 0.9 is a rubber ball.
#   friction  how much speed it keeps per tick, 0..1, like [physics] friction.
#             Low values also make it grip other windows more.
#
# These four are absolute settings, not toggles: they layer over the desktop's
# profile, so a heavy window stays heavy wherever it is dragged.
#
# There is no per-window "float" on purpose: tiling here is a property of the
# DESKTOP, not of the window, so such a rule could not be honoured. Use
# toggle_tiling on the desktop instead.
#
#[[rule]]
#app_id    = "^mpv$"
#nocollide = true          # video should not get shoved around by physics
#
#[[rule]]
#app_id  = "^(Slack|discord)$"
#desktop = 3               # chat always opens on desktop 4
#
#[[rule]]
#title = "^Picture-in-Picture$"
#pin   = true
#
#[[rule]]
#app_id = "^mpv$"
#mass   = 8.0              # a video player has some heft to it
#
#[[rule]]
#app_id  = "^(kitty|foot)$"
#mass    = 0.15            # terminals are light ...
#bounce  = 0.85            # ... and bouncy
#gravity = -0.1            # and drift gently upward when left alone

# Anything above with a numeric or colour value can also be changed live,
# without editing this file:
#
#   fwmctl config                        # list every option with its value
#   fwmctl set physics.gravity 200       # watch a window fall in slow motion
#   fwmctl set decor.col_active "#ff0000"
#
# Those changes last until the session ends or you reload (super+shift+r) —
# this file is never rewritten, so the comments you are reading survive.

# Wallpaper. fit = "cover" (fill+crop, static) | "contain" (whole image,
# letterboxed, static) | "pan" (walk across the image as you switch desktops)
# | "video" (a looping video, scaled to cover the screen).
# "pan" moves only images wide enough to stick out past the screen at native
# scale (roughly: wider than your screen's aspect). Those walk with nothing
# cropped. A narrower image is shown still rather than zoomed in, because
# buying travel means cropping its height — that trade is yours to make:
#   pan_crop = 0.25   # give up 25% of the height in exchange for travel
#   zoom     = 1.6    # or set the render width directly (screen_w * zoom)
# The log line for each layer reports the travel and crop you ended up with.

# Commented out on purpose: a placeholder path would be reported as a config
# problem (the tray pill) on a fresh install. Point it at a real image and
# uncomment, or just pick one with super+shift+p.
#[[wallpaper]]
#path = "/path/to/wallpaper.png"
#fit  = "pan"

# Animated (video) wallpaper. Any format ffmpeg can decode (mp4, mkv, webm…)
# loops forever, scaled to cover the screen. Decoding runs on its own thread
# (software) and is kept cheap: the compositor renders at the clip's fps (not a
# fixed 60), the H.264 loop filter is skipped, and it is PAUSED whenever a
# real-fullscreen window covers it. fit = "video" is optional — a path with a
# video extension is detected on its own.
#
# fps caps presentation (default: the clip's own rate). Set it to about HALF the
# clip's rate or less (e.g. 15 for a 30 fps clip) and the decoder also drops
# B-frames — the only thing that cuts the decode itself, ~30% on 1080p and ~35%
# on 4K here, at the cost of choppier motion. Above half it just paces output.
# On a 1080p screen prefer a 1080p clip: decoding 4K to shrink it to 1080p costs
# ~2x for nothing. It also pauses whenever any fullscreen window covers it.
#[[wallpaper]]
#path = "/home/you/Pictures/wallpaper.mp4"
#fit  = "video"
#fps  = 15
