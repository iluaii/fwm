#!/bin/sh
# fwm-sddm-sync — puts fwm's look where the login screen can read it.
#
# The greeter runs as its own user and cannot see into your home, so the
# wallpapers and the palette are copied into a directory it can read
# (/var/lib/fwm-sddm, made once by sddm/install.sh and owned by you), and
# theme.conf.user there tells the fwm theme what to use:
#
#   wall=<image>              the wallpaper, for any monitor
#   wall_<W>x<H>=<image>      the one each monitor of that size was showing
#   surface/foreground/accent/alarm, fill
#
# Videos become their first frame. The palette is matugen's, light or dark
# by how bright the wallpaper is — the same rule fwm-theme follows for
# Firefox — and `fill` is fwm's own [decor] tray_opacity.
#
# Run it from inside the session (it asks fwm for the monitors and the
# opacity through fwmctl); outside one it still copies the main wallpaper.
#
#   fwm-sddm-sync            from what fwm is showing now
#   FWM_SDDM_DIR=<dir>       somewhere else than /var/lib/fwm-sddm

set -eu

DIR=${FWM_SDDM_DIR:-/var/lib/fwm-sddm}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/fwm
THRESHOLD=115           # YAVG 0..255: above it the palette is light
SCHEME=scheme-vibrant
PREFER=saturation

if [ ! -w "$DIR" ]; then
    echo "fwm-sddm-sync: $DIR is not writable — run sddm/install.sh once" >&2
    exit 1
fi

main=$(cat "$STATE/wallpaper" 2>/dev/null || true)

# First frame, scaled to cover WxH (or as it is when no size is given), as a
# PNG the greeter can open — it does not decode video, or every format.
frame() {   # frame <source> <dest> [WxH]
    if [ -n "${3:-}" ]; then
        w=${3%x*}; h=${3#*x}
        vf="scale=${w}:${h}:force_original_aspect_ratio=increase,crop=${w}:${h}"
    else
        vf="scale='min(2560,iw)':-2"
    fi
    ffmpeg -hide_banner -loglevel error -y -i "$1" -vf "$vf" -frames:v 1 "$2.tmp.png" &&
        mv "$2.tmp.png" "$2" && chmod 644 "$2"
}

conf=$(mktemp "$DIR/.theme.conf.XXXXXX")
trap 'rm -f "$conf"' EXIT
echo "[General]" > "$conf"

if [ -r "$main" ] && frame "$main" "$DIR/wall.png"; then
    echo "wall=$DIR/wall.png" >> "$conf"
fi

# A wallpaper per monitor, keyed by its size: fwm names it DP-2, the
# greeter's X server DisplayPort-1, and only the size is the same to both.
outputs=$(fwmctl outputs 2>/dev/null | python3 -c '
import json, sys
try:
    for o in json.load(sys.stdin)["outputs"]:
        if o.get("enabled"):
            print(o["name"], o["width"], o["height"])
except Exception:
    pass
' 2>/dev/null || true)
echo "$outputs" | while read -r name w h; do
    [ -n "$name" ] || continue
    src=$(cat "$STATE/wallpaper.$name" 2>/dev/null || echo "$main")
    [ -r "$src" ] || continue
    if frame "$src" "$DIR/wall-${w}x${h}.png" "${w}x${h}"; then
        echo "wall_${w}x${h}=$DIR/wall-${w}x${h}.png" >> "$conf"
    fi
done

# The palette.
if [ -r "$main" ] && command -v matugen >/dev/null 2>&1; then
    yavg=$(ffmpeg -hide_banner -loglevel error -i "$main" \
             -vf "scale=64:64,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" \
             -frames:v 1 -f null - 2>/dev/null | grep -oE '=[0-9.]+' | tail -1 | tr -d '=')
    mode=$(awk -v y="${yavg:-0}" -v t="$THRESHOLD" 'BEGIN{print (y>t)?"light":"dark"}')
    matugen image "$main" -m "$mode" -t "$SCHEME" --prefer "$PREFER" \
            --json hex --dry-run 2>/dev/null | python3 -c '
import json, sys
c = json.load(sys.stdin)["colors"]
def get(k): return c[k]["default"]["color"]
print("surface=" + get("surface"))
print("foreground=" + get("on_surface"))
print("accent=" + get("primary"))
print("alarm=" + get("error"))
' >> "$conf" || true
fi

fill=$(fwmctl get decor.tray_opacity 2>/dev/null | python3 -c '
import json, sys
try: print(json.load(sys.stdin)["value"])
except Exception: pass
' 2>/dev/null || true)
[ -n "$fill" ] && echo "fill=$fill" >> "$conf"

chmod 644 "$conf"
mv "$conf" "$DIR/theme.conf.user"
trap - EXIT
