#!/bin/sh
# fwm-session — keep fwm running across crashes.
#
# A Wayland compositor cannot be restarted without taking its clients with it:
# it IS the display server, so a crash normally costs the whole working
# layout. This wrapper turns that into a few seconds — fwm comes back up and
# the applications it recorded in ~/.local/state/fwm/session are relaunched on
# the desktops they were on. They are relaunched, not resumed: anything unsaved
# inside them is still gone.
#
# A clean exit (the EXIT bind, super+shift+Escape) ends the session for good.
# Anything else counts as a crash — but a compositor that cannot start at all
# must not spin forever in front of a user with no way to intervene, so
# repeated fast failures give up and hand control back to the display manager.
#
# Set FWM_BINARY to run a build other than the installed one.

set -u

FWM="${FWM_BINARY:-fwm}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fwm"
LOG="$STATE_DIR/crash.log"

MAX_CRASHES=3    # this many failures...
WINDOW=60        # ...within this many seconds means it is not coming back

# Where the compositor's own stderr goes. A session that misbehaves after
# hours of being left alone leaves nothing behind unless somebody kept its
# log, and by the time it is noticed the only way to get the session back is
# to kill it — taking the scrollback with it. One previous run is kept as
# .log.1, which is the run you actually want to read after a restart.
LOGFILE="$STATE_DIR/fwm.log"

# Written by fwm, with its pid, the moment leaving is asked for and before
# anything is torn down. A crash in the teardown then still counts as the
# user leaving rather than as a crash to recover from: restarting the
# compositor over a login screen that is already coming back fights it for
# the screen and the input, and the machine with it.
EXIT_MARK="$STATE_DIR/exit-requested"

mkdir -p "$STATE_DIR"

# Without XDG_RUNTIME_DIR fwm has nowhere to put its socket and exits at
# once, three times, and the display manager is left showing black. It is
# elogind that sets it, from PAM, for a new login session — and it does not
# make one for a display manager that was itself started from inside a
# logged-in tty, which is exactly how one gets tried out. The directory is
# usually there anyway; take it when it is ours and closed to everyone else.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    rd="/run/user/$(id -u)"
    if [ -d "$rd" ] && [ -O "$rd" ] && [ "$(stat -c %a "$rd")" = 700 ]; then
        export XDG_RUNTIME_DIR="$rd"
        printf '%s: XDG_RUNTIME_DIR was not set, using %s\n' \
            "$(date -Is 2>/dev/null || date)" "$rd" >>"$LOG"
    fi
fi

crashes=0
window_start=$(date +%s)

# fwm runs as a child we know the pid of, so the mark above can be checked
# against it; the session ending under us takes it down too.
child=
trap 'if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null; wait "$child"; fi; exit 0' TERM INT HUP

while :; do
    [ -f "$LOGFILE" ] && mv -f "$LOGFILE" "$LOGFILE.1"
    rm -f "$EXIT_MARK"
    "$FWM" "$@" 2>>"$LOGFILE" &
    child=$!
    wait "$child"
    code=$?
    pid=$child
    child=

    if [ "$code" -eq 0 ]; then
        exit 0    # the user asked to leave
    fi

    if [ "$(cat "$EXIT_MARK" 2>/dev/null)" = "$pid" ]; then
        printf '%s: fwm exited with code %s while leaving; it was asked to, so not restarting\n' \
            "$(date -Is 2>/dev/null || date)" "$code" >>"$LOG"
        rm -f "$EXIT_MARK"
        exit 0
    fi

    now=$(date +%s)
    if [ $((now - window_start)) -gt "$WINDOW" ]; then
        crashes=0                 # the last failure was long ago; start over
        window_start=$now
    fi
    crashes=$((crashes + 1))

    printf '%s: fwm exited with code %s (failure %s of %s)\n' \
        "$(date -Is 2>/dev/null || date)" "$code" "$crashes" "$MAX_CRASHES" >>"$LOG"

    if [ "$crashes" -ge "$MAX_CRASHES" ]; then
        printf '%s: giving up after %s failures in %ss\n' \
            "$(date -Is 2>/dev/null || date)" "$crashes" "$WINDOW" >>"$LOG"
        echo "fwm-session: fwm failed $crashes times in ${WINDOW}s — see $LOG" >&2
        exit "$code"
    fi

    sleep 1
done
